# Off-site backups, read by backup-db.sh. Copy to backup.env (chmod 600) and fill in; keep a copy of every value in
# Bitwarden: without RESTIC_PASSWORD the backups can't be decrypted. This repository is public, never commit backup.env.
# See README.md, "Backups".

# R2 bucket in the EU jurisdiction (only reachable through the .eu. endpoint).
RESTIC_REPOSITORY=s3:https://<account-id>.eu.r2.cloudflarestorage.com/material-backups
# openssl rand -hex 32
RESTIC_PASSWORD=
# R2 API token with "Object Read & Write" for this bucket only.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
# healthchecks.io check "material backup"; anyone with this URL can send pings.
HC_PING_URL=https://hc-ping.com/<uuid>
